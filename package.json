{
  "name": "chessgod-extension",
  "version": "0.1.0",
  "description": "An extensively configurable chess bot for chess.com",
  "license": "MIT",
  "author": "Calasicio",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "npm run build -- --watch & web-ext run --source-dir=dist",
    "typecheck": "tsc --noEmit",
    "ext-build": "web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts --overwrite-dest",
    "release": "npm run typecheck && npm run build && npm run ext-build"
  },
  "dependencies": {
    "@types/firefox-webext-browser": "^143.0.0",
    "chess.js": "^1.4.0",
    "esbuild": "^0.28.1",
    "stockfish": "^18.0.8",
    "typescript": "^7.0.2",
    "web-ext": "^10.6.0"
  }
}
